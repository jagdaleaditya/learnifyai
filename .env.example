# Browser-side settings (bundled into the public JS, so NEVER put secrets here).
# Firebase web config. Restrict this key to your domain in Google Cloud Console → Credentials.
VITE_GOOGLE_API_KEY=your-firebase-web-api-key
# Optional overrides (defaults are the existing learnify-f0a94 project)
# VITE_FIREBASE_AUTH_DOMAIN=learnify-f0a94.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=learnify-f0a94
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Leave empty when Nginx serves the site and proxies /api on the same domain (recommended).
# If the API is on another domain, use https:// and add that domain to ALLOWED_ORIGINS on the server
# and to connect-src in the Content-Security-Policy.
VITE_API_BASE=
