# Server-side only. Never import these in src/ (the browser bundle).
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_API_KEY=your-ollama-key
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
PORT=8787

# ---------- Production / HTTPS ----------
# NODE_ENV=production hides internal error messages from visitors.
NODE_ENV=production
# 127.0.0.1 when Nginx runs on the same machine. 0.0.0.0 only inside Docker.
HOST=127.0.0.1
# Accept requests that come through the reverse proxy (needed when the site is public).
ALLOW_REMOTE=1
# Trust exactly one proxy hop (Nginx) so the real client IP and https are detected.
TRUST_PROXY=1
# Refuse API calls that did not arrive over HTTPS.
FORCE_HTTPS=1
# Extra origins allowed to call the API from a browser (comma separated). Same-origin always works.
ALLOWED_ORIGINS=
# Protects /api/auth/users, /api/auth/logs, /api/dataset and /api/ingest for remote callers.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ---------- Abuse limits ----------
RATE_LIMIT_PER_MIN=120
HEAVY_LIMIT_PER_MIN=10
MAX_CONCURRENT_JOBS=3
MAX_CONCURRENT_RUNS=4
# Set to 0 to disable the "Run code" endpoint for remote users entirely.
ENABLE_CODE_RUN=1
